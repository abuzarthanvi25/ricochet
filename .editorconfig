# Keep in sync with .prettierrc.json and .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Prettier uses printWidth 80 for prose; trailing spaces are a line break in md.
max_line_length = 80
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
